# Admin account created on first startup
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=change-this-to-a-strong-password

# Session and server configuration
FLASK_SECRET_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=false
FLASK_PORT=5000

# Optional fallback IMAP credentials.
# Preferred: configure these after admin login in Settings.
EMAIL_USER=
EMAIL_PASS=

# Legacy Telegram-data compatibility. Defaults to 0 when omitted.
ADMIN_ID=0
WEB_ADMIN_TELEGRAM_ID=

# Optional deployment settings
PORT=
PUBLIC_API_URL=
RAILWAY_VOLUME_MOUNT_PATH=/data
IMAP_TIMEOUT_SECONDS=10
